{
  "manifest_version": 3,
  "name": "Open Passwords",
  "version": "1.0.1",
  "description": "Fill and save Apple Passwords credentials in Chromium on macOS, with on-demand passkey support.",
  "key": "",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Open Passwords"
  },
  "permissions": [
    "alarms",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*.localhost/*",
    "http://*.test/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://*.localhost/*",
        "http://*.test/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://*.localhost/*",
        "http://*.test/*"
      ],
      "js": [
        "src/passkey-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://*.localhost/*",
        "http://*.test/*"
      ],
      "js": [
        "src/passkey-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
